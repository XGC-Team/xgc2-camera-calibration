<launch>
  <arg name="socket_path" />
  <arg name="target_id" />
  <arg name="resolved_extrinsic_json" />
  <arg name="frame_roles_json" />
  <arg name="calibration_mode" />
  <arg name="camera_name" />
  <arg name="parent_frame" />
  <arg name="camera_link_frame" />
  <arg name="optical_frame" />
  <arg name="link_to_optical_x" default="0.0" />
  <arg name="link_to_optical_y" default="0.0" />
  <arg name="link_to_optical_z" default="0.0" />
  <arg name="static" default="true" />
  <arg name="publish_rate" default="10.0" />

  <node pkg="xgc_camera_calibration"
        type="extrinsic_tf_publisher.py"
        name="xgc_camera_extrinsic_tf"
        output="screen"
        args="--resolved-extrinsic-json '$(arg resolved_extrinsic_json)' --frame-roles-json '$(arg frame_roles_json)'">
    <param name="socket_path" value="$(arg socket_path)" />
    <param name="target_id" value="$(arg target_id)" />
    <param name="calibration_mode" value="$(arg calibration_mode)" />
    <param name="camera_name" value="$(arg camera_name)" />
    <param name="parent_frame" value="$(arg parent_frame)" />
    <param name="camera_link_frame" value="$(arg camera_link_frame)" />
    <param name="optical_frame" value="$(arg optical_frame)" />
    <param name="link_to_optical_x" value="$(arg link_to_optical_x)" />
    <param name="link_to_optical_y" value="$(arg link_to_optical_y)" />
    <param name="link_to_optical_z" value="$(arg link_to_optical_z)" />
    <param name="static" value="$(arg static)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
  </node>
</launch>
