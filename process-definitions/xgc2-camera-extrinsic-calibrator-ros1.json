{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xgc2-camera-extrinsic-calibrator-ros1",
      "version": "3.0.0",
      "label": "XGC2 camera extrinsic calibration WebUI",
      "description": "Consume compressed ROS images or capture and CameraInfo or an explicit intrinsic YAML, solve robust PnP, and expose parent_T_camera_optical with residuals at GET /v1/result for Core to commit.",
      "parameters": {
        "groups": [
          {
            "id": "camera-context",
            "label": "Camera context",
            "collapsed": true,
            "parameters": [
              "calibrationMode",
              "cameraName"
            ]
          },
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosMasterUri",
              "rosLogDir"
            ]
          }
        ],
        "properties": {
          "imageTopic": {
            "type": "string",
            "default": "/usb_cam/image_raw/compressed",
            "description": "CompressedImage topic from camera:<id>; capture or this topic supplies immutable frames."
          },
          "previewImageTopic": {
            "type": "string",
            "default": "/usb_cam/image_raw/compressed"
          },
          "intrinsicFile": {
            "type": "string",
            "default": "",
            "description": "Absolute path to the timestamped xgc2.camera.intrinsic.v1 YAML used by solvePnP.",
            "x-xgc-path-kind": "file",
            "x-xgc-file-extensions": [
              ".yaml"
            ]
          },
          "mediaSourceId": {
            "type": "string",
            "default": "usb_cam",
            "description": "Source identity from the per-camera media:<id> facts; capture consumes this source."
          },
          "snapshotTimeout": {
            "type": "number",
            "default": 5.0,
            "minimum": 0.1
          },
          "poseCoordinateSource": {
            "type": "string",
            "default": "unspecified",
            "enum": [
              "unspecified",
              "raw-vrpn",
              "experiment-world"
            ],
            "description": "Explicit coordinate provenance of pose input; never inferred from ROS frame names."
          },
          "posePrefix": {
            "type": "string",
            "default": "/vrpn_client_node"
          },
          "trackers": {
            "type": "string",
            "default": "",
            "description": "Comma-separated UAV/UGV names allowed as pose markers; empty discovers all markers under posePrefix."
          },
          "calibrationMode": {
            "type": "string",
            "default": "sim",
            "enum": [
              "sim",
              "phy"
            ],
            "description": "Camera calibration origin supplied by the Experiment run mode."
          },
          "cameraName": {
            "type": "string",
            "default": "usb_cam",
            "description": "Stable camera identity from camera:<id>; independent of ROS frame names."
          },
          "parentFrame": {
            "type": "string",
            "description": "Exact frame id from camera:<id> in the session registry."
          },
          "opticalFrame": {
            "type": "string",
            "description": "Exact frame id from camera:<id> in the session registry."
          },
          "maximumErrorPx": {
            "type": "number",
            "default": 10.0,
            "minimum": 0.0
          },
          "freezeImageTimeout": {
            "type": "number",
            "default": 2.0,
            "minimum": 0.1
          },
          "jpegQuality": {
            "type": "integer",
            "default": 80,
            "minimum": 1,
            "maximum": 100
          },
          "bindAddress": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "httpPort": {
            "type": "integer",
            "default": 18082,
            "minimum": 1,
            "maximum": 65535
          },
          "frameAncestors": {
            "type": "string",
            "default": "'''self'' http://127.0.0.1:* http://localhost:*'"
          },
          "allowedOrigins": {
            "type": "string",
            "default": ""
          },
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311",
            "output": true
          },
          "rosLogDir": {
            "type": "string",
            "default": "/tmp/xgc2/ros/log/camera-calibration"
          },
          "resolvedExtrinsicJson": {
            "type": "string",
            "description": "One immutable extrinsic resolution produced by the camera workflow."
          },
          "frameRolesJson": {
            "type": "string",
            "description": "Exact parent and optical frame roles from the camera fragment."
          },
          "mediaEdgeRPCSocket": {
            "type": "string",
            "description": "Private Unix endpoint from media:<id> in the session registry.",
            "default": ""
          },
          "socketPath": {
            "type": "string",
            "fixedOnly": true,
            "description": "Product-owned private calibration endpoint allocated by Core; GET /v1/result exposes the computed candidate."
          },
          "targetId": {
            "type": "string",
            "fixedOnly": true,
            "description": "Core target identity for local service discovery; supplied by the registry."
          },
          "cameraInfoTopic": {
            "type": "string",
            "default": "/usb_cam/camera_info",
            "description": "CameraInfo topic from camera:<id>; used when intrinsicFile is empty."
          }
        },
        "required": [
          "resolvedExtrinsicJson",
          "socketPath",
          "targetId",
          "parentFrame",
          "opticalFrame",
          "frameRolesJson"
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc_camera_calibration/extrinsic_calibrator_web.py",
        "args": [
          "--resolved-extrinsic-json",
          "${resolvedExtrinsicJson}",
          "--frame-roles-json",
          "${frameRolesJson}",
          "__name:=xgc_camera_extrinsic_calibrator_web",
          "_image_topic:=${imageTopic}",
          "_preview_image_topic:=${previewImageTopic}",
          "_intrinsic_file:=${intrinsicFile}",
          "_media_edge_rpc_socket:=${mediaEdgeRPCSocket}",
          "_media_source_id:=${mediaSourceId}",
          "_snapshot_timeout:=${snapshotTimeout}",
          "_pose_prefix:=${posePrefix}",
          "_pose_coordinate_source:=${poseCoordinateSource}",
          "_trackers:=${trackers}",
          "_calibration_mode:=${calibrationMode}",
          "_camera_name:=${cameraName}",
          "_parent_frame:=${parentFrame}",
          "_child_frame:=${opticalFrame}",
          "_maximum_inlier_error_px:=${maximumErrorPx}",
          "_freeze_image_timeout:=${freezeImageTimeout}",
          "_jpeg_quality:=${jpegQuality}",
          "_bind_address:=${bindAddress}",
          "_http_port:=${httpPort}",
          "_frame_ancestors:=${frameAncestors}",
          "_allowed_origins:=${allowedOrigins}",
          "_socket_path:=${socketPath}",
          "_target_id:=${targetId}",
          "_camera_info_topic:=${cameraInfoTopic}"
        ],
        "env": {
          "ROS_MASTER_URI": "${rosMasterUri}",
          "ROS_LOG_DIR": "${rosLogDir}"
        }
      },
      "services": [
        {
          "service": "xgc2.calibration.v1.Calibration",
          "api_version": "1",
          "profile": "http.v1",
          "endpointParameter": "socketPath"
        }
      ],
      "setupFiles": [
        "/opt/ros/noetic/setup.bash"
      ],
      "readiness": {
        "kind": "describe",
        "startGraceMs": 30000,
        "timeoutMs": 30000
      },
      "stop": {
        "graceMs": 5000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
