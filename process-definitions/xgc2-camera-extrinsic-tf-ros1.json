{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xgc2-camera-extrinsic-tf-ros1",
      "version": "1.4.0",
      "label": "XGC2 camera extrinsic TF",
      "description": "Publish the immutable camera pose supplied by Core; Core commits calibration results and starts the camera fragment with its selected pose.",
      "parameters": {
        "groups": [
          {
            "id": "camera-context",
            "label": "Camera context",
            "collapsed": true,
            "parameters": [
              "calibrationMode",
              "cameraName"
            ]
          },
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosMasterUri",
              "rosLogDir"
            ]
          }
        ],
        "properties": {
          "calibrationMode": {
            "type": "string",
            "default": "sim",
            "enum": [
              "sim",
              "phy"
            ],
            "description": "Camera calibration origin supplied by the Experiment run mode."
          },
          "cameraName": {
            "type": "string",
            "default": "usb_cam",
            "description": "Stable camera identity from camera:<id>; independent of ROS frame names."
          },
          "parentFrame": {
            "type": "string",
            "description": "Exact frame id from camera:<id> in the session registry."
          },
          "cameraLinkFrame": {
            "type": "string",
            "description": "Exact frame id from camera:<id> in the session registry."
          },
          "opticalFrame": {
            "type": "string",
            "description": "Exact frame id from camera:<id> in the session registry."
          },
          "linkToOpticalX": {
            "type": "number",
            "default": 0.0
          },
          "linkToOpticalY": {
            "type": "number",
            "default": 0.0
          },
          "linkToOpticalZ": {
            "type": "number",
            "default": 0.0
          },
          "static": {
            "type": "boolean",
            "default": true
          },
          "publishRate": {
            "type": "number",
            "default": 10.0,
            "minimum": 0.1
          },
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311",
            "output": true
          },
          "rosLogDir": {
            "type": "string",
            "default": "/var/lib/xgc2/ros/log/camera-tf"
          },
          "resolvedExtrinsicJson": {
            "type": "string",
            "description": "One immutable extrinsic resolution produced by the camera workflow."
          },
          "frameRolesJson": {
            "type": "string",
            "description": "Exact parent and optical frame roles from the camera fragment."
          },
          "socketPath": {
            "type": "string",
            "fixedOnly": true,
            "description": "Private TF readiness endpoint allocated by Core."
          },
          "targetId": {
            "type": "string",
            "fixedOnly": true,
            "description": "Core target identity for local service discovery."
          }
        },
        "required": [
          "resolvedExtrinsicJson",
          "parentFrame",
          "opticalFrame",
          "cameraLinkFrame",
          "frameRolesJson",
          "socketPath",
          "targetId"
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc_camera_calibration/extrinsic_tf_publisher.py",
        "args": [
          "--resolved-extrinsic-json",
          "${resolvedExtrinsicJson}",
          "--frame-roles-json",
          "${frameRolesJson}",
          "__name:=xgc_camera_extrinsic_tf",
          "_calibration_mode:=${calibrationMode}",
          "_camera_name:=${cameraName}",
          "_parent_frame:=${parentFrame}",
          "_camera_link_frame:=${cameraLinkFrame}",
          "_optical_frame:=${opticalFrame}",
          "_link_to_optical_x:=${linkToOpticalX}",
          "_link_to_optical_y:=${linkToOpticalY}",
          "_link_to_optical_z:=${linkToOpticalZ}",
          "_static:=${static}",
          "_publish_rate:=${publishRate}",
          "_socket_path:=${socketPath}",
          "_target_id:=${targetId}"
        ],
        "env": {
          "ROS_MASTER_URI": "${rosMasterUri}",
          "ROS_LOG_DIR": "${rosLogDir}"
        }
      },
      "setupFiles": [
        "/opt/ros/noetic/setup.bash"
      ],
      "readiness": {
        "kind": "describe",
        "startGraceMs": 30000,
        "timeoutMs": 30000
      },
      "stop": {
        "graceMs": 5000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      },
      "services": [
        {
          "service": "xgc2.calibration.v1.ExtrinsicTf",
          "api_version": "1",
          "profile": "http.v1",
          "endpointParameter": "socketPath"
        }
      ]
    }
  ]
}
